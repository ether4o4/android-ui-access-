# Copy to .env or run: python -m src.setup_env
# Never commit real credentials.

# Telegram (token required; chat ID optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub (optional)
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=

# Selected AI providers: comma-separated slugs from --list-providers
AI_PROVIDERS=openai,ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini

# Provider credentials/endpoints (fill only the providers you select)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
SKYWORK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
HUGGINGFACE_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=
FAL_API_KEY=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_URL=http://127.0.0.1:3001
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_URL=http://127.0.0.1:11434
LMSTUDIO_URL=http://127.0.0.1:1234
LOCALAI_URL=http://127.0.0.1:8080
LOCALAI_API_KEY=

# Optional search, data, and cloud integrations
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
PINECONE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Webhook/tunnel values are reserved for webhook mode; polling is the default.
WEBHOOK_PORT=8080
WEBHOOK_PATH=/telegram
CLOUDFLARED_TOKEN=
PUBLIC_BASE_URL=

APP_ENV=local
LOG_LEVEL=INFO
